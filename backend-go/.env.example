# API Keys
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_API_KEY=openai_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Модели
DEFAULT_MODEL=moonshotai/kimi-k2-0905
DEFAULT_EMBEDDING_MODEL=openai/gpt-oss-120b
CROSS_ENCODER_MODEL=google/gemma-3-12b-it

# Qdrant
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=qdrant_api_key

# Временные файлы
TEMPFILE_DIR=./tmp
TEMPFILE_CLEANUP_INTERVAL_SECONDS=3600

# Домены и фронт
DOMAIN=http://localhost:3000
FRONT_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pg_pass
POSTGRES_DB=aifixeddb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
SECRET_KEY=jwt_secret_key
ALGORITHM=HS256

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aifixedcompany@gmail.com
SMTP_PASSWORD=smtp_pass
SMTP_FROM_EMAIL=aifixedcompany@gmail.com

# GitHub OAuth
GITHUB_CLIENT_ID=gh_client_id
GITHUB_CLIENT_SECRET=gh_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Embedding microservice
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_PORT=8001